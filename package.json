{
  "name": "@catyugu/dsh-web-pack",
  "version": "0.5.2",
  "type": "module",
  "description": "A pack of switchable DSH Web plugins: session management and session cleanup.",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.4 <0.3.0-0"
  },
  "meta": {
    "title": "dsh-web-pack",
    "description": "A pack of switchable DSH Web plugins: session management and session cleanup."
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "packages/*/package.json",
    "packages/*/README.md",
    "packages/*/LICENSE",
    "packages/*/icon.svg",
    "packages/*/locale",
    "packages/*/client.js",
    "packages/*/src/*.js",
    "!packages/*/src/client.js",
    "packages/dsh-remote-web/lib"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-remote-web.mjs",
    "build:remote-web": "node scripts/build-remote-web.mjs",
    "test": "node --test --test-concurrency=1 \"packages/*/test/*.test.mjs\"",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catyugu/dsh-web-pack.git"
  },
  "dependencies": {
    "@catyugu/dsh-better-session": "file:./packages/dsh-better-session",
    "@catyugu/dsh-remote-web": "file:./packages/dsh-remote-web",
    "@catyugu/dsh-session-cleanup": "file:./packages/dsh-session-cleanup"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "qrcode.react": "^4.2.0"
  }
}
