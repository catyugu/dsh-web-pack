{
  "name": "dsh-web-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pack of switchable DSH Web plugins: session management and session cleanup.",
  "license": "MIT",
  "icon": "./icon.svg",
  "meta": {
    "title": "dsh-web-pack",
    "description": "A pack of switchable DSH Web plugins: session management and session cleanup."
  },
  "files": [
    "cordis.patch.yml",
    "packages",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "dsh-better-session": "github:catyugu/dsh-web-pack#path:/packages/dsh-better-session",
    "dsh-session-cleanup": "github:catyugu/dsh-web-pack#path:/packages/dsh-session-cleanup"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test --test-concurrency=1 \"packages/*/test/*.test.mjs\"",
    "check": "npm run build && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catyugu/dsh-web-pack.git"
  }
}
